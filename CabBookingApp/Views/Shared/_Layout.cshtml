<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RideFast</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚖</text></svg>" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CabBookingApp.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- ── Offer Bar ── -->
    <div class="offer-bar" id="offerBar">
        <div class="offer-track-wrap">
            <div class="offer-track" id="offerTrack">
                <span class="offer-item">
                    <i class="bi bi-gift-fill me-1"></i>
                    <strong>NEW USER:</strong> First ride FREE &mdash; Use code <strong class="offer-code">FIRST100</strong>
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-lightning-charge-fill me-1"></i>
                    <strong>WEEKEND SPECIAL:</strong> Flat 20% off on all outstation bookings &mdash; Code <strong class="offer-code">WEEKEND20</strong>
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-currency-rupee me-1"></i>
                    <strong>SAVE ₹100:</strong> On trips above ₹500 &mdash; Use code <strong class="offer-code">SAVE100</strong>
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-star-fill me-1"></i>
                    <strong>REFER &amp; EARN:</strong> Get ₹50 credit for every friend you refer!
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-truck-front-fill me-1"></i>
                    <strong>GROUP TRAVEL:</strong> Book a Tempo Traveller &mdash; 15% off on 10+ seats &mdash; Code <strong class="offer-code">GROUP15</strong>
                </span>
                <!-- duplicate for seamless loop -->
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-gift-fill me-1"></i>
                    <strong>NEW USER:</strong> First ride FREE &mdash; Use code <strong class="offer-code">FIRST100</strong>
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-lightning-charge-fill me-1"></i>
                    <strong>WEEKEND SPECIAL:</strong> Flat 20% off on all outstation bookings &mdash; Code <strong class="offer-code">WEEKEND20</strong>
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-currency-rupee me-1"></i>
                    <strong>SAVE ₹100:</strong> On trips above ₹500 &mdash; Use code <strong class="offer-code">SAVE100</strong>
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-star-fill me-1"></i>
                    <strong>REFER &amp; EARN:</strong> Get ₹50 credit for every friend you refer!
                </span>
                <span class="offer-sep">&#9670;</span>
                <span class="offer-item">
                    <i class="bi bi-truck-front-fill me-1"></i>
                    <strong>GROUP TRAVEL:</strong> Book a Tempo Traveller &mdash; 15% off on 10+ seats &mdash; Code <strong class="offer-code">GROUP15</strong>
                </span>
            </div>
        </div>
        <button class="offer-close" id="offerClose" title="Dismiss offers" aria-label="Close offer bar">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <!-- ── End Offer Bar ── -->

    <header>
        <nav class="site-navbar navbar navbar-expand-lg sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-taxi">&#128661;</span>
                    <span class="brand-name">RideFast</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3 text-white"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Routes" asp-action="Index">
                                <i class="bi bi-signpost-split me-1"></i>Routes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Bookings" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i>My Bookings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Faq" asp-action="Index">
                                <i class="bi bi-patch-question me-1"></i>FAQ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check me-1"></i>Privacy
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 ms-lg-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light rounded-pill px-3 dropdown-toggle d-flex align-items-center gap-2"
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar-sm">@User.Identity.Name[0].ToString().ToUpper()</span>
                                    <span class="d-none d-lg-inline text-truncate" style="max-width:110px">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-dark small">@User.Identity.Name</div>
                                        <div class="text-muted" style="font-size:.78rem">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                    </li>
                                    <li>
                                        <a asp-controller="Bookings" asp-action="Index" class="dropdown-item py-2">
                                            <i class="bi bi-journal-bookmark me-2 text-warning"></i>My Bookings
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a asp-controller="Admin" asp-action="Index" class="dropdown-item py-2">
                                                <i class="bi bi-shield-lock me-2 text-danger"></i>Admin Panel
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light rounded-pill px-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                            </a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-warning rounded-pill px-3 d-none d-sm-inline-flex">
                                Register
                            </a>
                        }
                        <a asp-controller="Bookings" asp-action="Create" class="btn btn-warning fw-bold px-4 rounded-pill">
                            <i class="bi bi-taxi-front me-1"></i>Book Now
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span style="font-size:2rem">&#128661;</span>
                        <span class="fw-bold fs-4 text-white">RideFast</span>
                    </div>
                    <p class="text-white-50 mb-3">Your most trusted cab service. Safe, reliable and affordable rides — available 24/7 across the city.</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="footer-social"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-social"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="footer-social"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="footer-social"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1"></i>Home</a></li>
                        <li><a asp-controller="Bookings" asp-action="Index"><i class="bi bi-chevron-right me-1"></i>My Bookings</a></li>
                        <li><a asp-controller="Bookings" asp-action="Create"><i class="bi bi-chevron-right me-1"></i>Book a Ride</a></li>
                        <li><a asp-controller="Faq" asp-action="Index"><i class="bi bi-chevron-right me-1"></i>FAQ</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-chevron-right me-1"></i>Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Contact Us</h6>
                    <ul class="list-unstyled footer-links">
                        <li><i class="bi bi-telephone-fill me-2 text-warning"></i>+91 85849 64672</li>
                        <li><i class="bi bi-envelope-fill me-2 text-warning"></i>support@ridefast.in</li>
                        <li><i class="bi bi-geo-alt-fill me-2 text-warning"></i>Siwan, Bihar</li>
                        <li><i class="bi bi-clock-fill me-2 text-warning"></i>24/7 Customer Support</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4 mb-3" />
            <p class="text-center text-white-50 small mb-0">
                &copy; 2026 RideFast. All rights reserved. &mdash; Drive safe, arrive happy.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function () {
            var bar   = document.getElementById('offerBar');
            var close = document.getElementById('offerClose');
            if (!bar) return;

            // Hide if user dismissed today
            var dismissed = localStorage.getItem('offerBarDismissed');
            if (dismissed && new Date().toDateString() === dismissed) {
                bar.style.display = 'none';
            }

            if (close) {
                close.addEventListener('click', function () {
                    bar.style.animation = 'offerSlideUp .35s ease forwards';
                    setTimeout(function () { bar.style.display = 'none'; }, 350);
                    localStorage.setItem('offerBarDismissed', new Date().toDateString());
                });
            }

            // Pause marquee on hover
            var track = document.getElementById('offerTrack');
            if (track) {
                bar.addEventListener('mouseenter', function () { track.style.animationPlayState = 'paused'; });
                bar.addEventListener('mouseleave', function () { track.style.animationPlayState = 'running'; });
            }
        })();
    </script>
</body>
</html>
