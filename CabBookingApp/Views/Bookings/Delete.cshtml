@model CabBookingApp.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Bookings" asp-action="Index">Bookings</a></li>
                <li class="breadcrumb-item active">Delete #@Model.Id</li>
            </ol>
        </nav>
        <h1 class="text-danger"><i class="bi bi-trash me-2"></i>Delete Booking</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="alert alert-danger d-flex align-items-start gap-3 rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0 mt-1"></i>
                <div>
                    <strong>This action cannot be undone.</strong><br />
                    Are you sure you want to permanently delete this booking?
                </div>
            </div>

            <div class="delete-warning-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-circle me-2"></i>@Model.CustomerName</span>
                    <span class="badge bg-warning text-dark">Booking #@Model.Id</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr class="border-bottom">
                                <td class="ps-4 py-3 text-muted fw-semibold" style="width:40%">Mobile Number</td>
                                <td class="py-3">@Model.CustomerMobileNumber</td>
                            </tr>
                            <tr class="border-bottom">
                                <td class="ps-4 py-3 text-muted fw-semibold">Pickup</td>
                                <td class="py-3"><i class="bi bi-geo me-1 text-success"></i>@Model.Source</td>
                            </tr>
                            <tr class="border-bottom">
                                <td class="ps-4 py-3 text-muted fw-semibold">Drop</td>
                                <td class="py-3"><i class="bi bi-geo-fill me-1 text-danger"></i>@Model.Destination</td>
                            </tr>
                            <tr class="border-bottom">
                                <td class="ps-4 py-3 text-muted fw-semibold">Travel Date &amp; Time</td>
                                <td class="py-3">@Model.TravelDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>
                            <tr>
                                <td class="ps-4 py-3 text-muted fw-semibold">Booking Amount</td>
                                <td class="py-3"><span class="amount-badge">&#8377; @Model.BookingAmount.ToString("N2")</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-3 flex-wrap">
                    <button type="submit" class="btn btn-danger fw-bold px-5 rounded-pill btn-lg">
                        <i class="bi bi-trash me-1"></i>Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>
