@model CabBookingApp.Models.Booking

@{
    ViewData["Title"] = "New Booking";
    var vehicles = new[] {
        ("Hatchback",       "bi-car-front",       "4 seats · Budget"),
        ("Sedan",           "bi-car-front-fill",   "4 seats · Comfort"),
        ("SUV",             "bi-truck-front-fill", "6 seats · Premium"),
        ("Tempo Traveller", "bi-bus-front-fill",   "12 seats · Group"),
    };
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Bookings" asp-action="Index">Bookings</a></li>
                <li class="breadcrumb-item active">New Booking</li>
            </ol>
        </nav>
        <h1><i class="bi bi-taxi-front me-2"></i>New Booking</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="form-card">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center gap-2 rounded-3 mb-4 py-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i><div></div>
                </div>

                <form asp-action="Create" novalidate>

                    <!-- Customer Info -->
                    <h6 class="form-section-title"><i class="bi bi-person-circle me-2 text-warning"></i>Customer Details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="CustomerName" class="form-label">Full Name</label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name" />
                            <span asp-validation-for="CustomerName" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="CustomerMobileNumber" class="form-label">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text">+91</span>
                                <input asp-for="CustomerMobileNumber" class="form-control" placeholder="10-digit number" maxlength="10" inputmode="numeric" />
                            </div>
                            <span asp-validation-for="CustomerMobileNumber" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Trip Info -->
                    <h6 class="form-section-title"><i class="bi bi-signpost-split me-2 text-warning"></i>Trip Details</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Source" class="form-label"><i class="bi bi-geo me-1 text-success"></i>Pickup Location</label>
                            <input asp-for="Source" class="form-control" placeholder="From where?" />
                            <span asp-validation-for="Source" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Destination" class="form-label"><i class="bi bi-geo-fill me-1 text-danger"></i>Drop Location</label>
                            <input asp-for="Destination" class="form-control" placeholder="Going where?" />
                            <span asp-validation-for="Destination" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Vehicle Type -->
                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-car-front me-1 text-warning"></i>Vehicle Type</label>
                        <span asp-validation-for="VehicleType" class="text-danger small ms-2"></span>
                        <div class="vt-form-grid">
                            @foreach (var (type, icon, desc) in vehicles)
                            {
                                var vid = "vt-" + type.Replace(" ", "-");
                                <div>
                                    <input type="radio" class="btn-check" asp-for="VehicleType" id="@vid" value="@type" />
                                    <label class="vt-form-btn" for="@vid">
                                        <i class="bi @icon vt-form-icon"></i>
                                        <span class="vt-form-name">@type</span>
                                        <span class="vt-form-desc">@desc</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Date, Time & Amount -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-7">
                            <label asp-for="TravelDateTime" class="form-label"><i class="bi bi-calendar-event me-1 text-warning"></i>Travel Date &amp; Time</label>
                            <input asp-for="TravelDateTime" type="datetime-local" class="form-control" />
                            <span asp-validation-for="TravelDateTime" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-sm-5">
                            <label asp-for="BookingAmount" class="form-label"><i class="bi bi-currency-rupee me-1 text-warning"></i>Booking Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">&#8377;</span>
                                <input asp-for="BookingAmount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="BookingAmount" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold px-5 rounded-pill">
                            <i class="bi bi-check-lg me-1"></i>Save Booking
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">Cancel</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
