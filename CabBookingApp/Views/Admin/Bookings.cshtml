@model IEnumerable<CabBookingApp.Models.Booking>

@{
    ViewData["Title"] = "All Bookings";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item active">All Bookings</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="mb-1"><i class="bi bi-journal-bookmark me-2"></i>All Bookings</h1>
                <p class="text-white-50 small mb-0">@Model.Count() total booking(s) across all users.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 mb-4">
            <i class="bi bi-check-circle-fill fs-5"></i><div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x text-muted" style="font-size:4rem"></i>
            <h4 class="mt-3 text-muted">No bookings yet</h4>
        </div>
    }
    else
    {
        <div class="table-responsive rounded-3 shadow-sm">
            <table class="table bookings-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Mobile</th>
                        <th>Vehicle</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Travel Date &amp; Time</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="text-muted fw-semibold">#@b.Id</td>
                            <td class="fw-semibold">@b.CustomerName</td>
                            <td>@b.CustomerMobileNumber</td>
                            <td><span class="badge bg-dark text-warning">@b.VehicleType</span></td>
                            <td>@b.Source</td>
                            <td>@b.Destination</td>
                            <td>@b.TravelDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td><span class="amount-badge">₹@b.BookingAmount.ToString("N2")</span></td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id"
                                       class="btn btn-sm btn-outline-secondary rounded-pill" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Bookings" asp-action="Edit" asp-route-id="@b.Id"
                                       class="btn btn-sm btn-outline-warning rounded-pill" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="Bookings" asp-action="Delete" asp-route-id="@b.Id"
                                       class="btn btn-sm btn-outline-danger rounded-pill" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-2">
            <i class="bi bi-info-circle me-1"></i>@Model.Count() booking(s) found.
        </p>
    }
</div>
