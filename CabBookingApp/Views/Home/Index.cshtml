@section Scripts {
<script>
const PRICES = {
    "Gorakhpur":  { "Hatchback":[2200,2800], "Sedan":[2900,3600], "SUV":[4000,5000], "Tempo Traveller":[5500,7000] },
    "Varanasi":   { "Hatchback":[2500,3200], "Sedan":[3200,4000], "SUV":[4500,5500], "Tempo Traveller":[6000,7500] },
    "Prayagraj":  { "Hatchback":[2800,3500], "Sedan":[3800,4800], "SUV":[5200,6500], "Tempo Traveller":[7000,8500] },
    "Lucknow":    { "Hatchback":[4500,5500], "Sedan":[5800,7200], "SUV":[7800,9800], "Tempo Traveller":[10500,13500] },
    "Kanpur":     { "Hatchback":[4800,5800], "Sedan":[6200,7800], "SUV":[8200,10500],"Tempo Traveller":[11000,14500] },
    "Agra":       { "Hatchback":[7500,9000], "Sedan":[9500,12000],"SUV":[13500,17000],"Tempo Traveller":[18000,23000] },
    "Delhi":      { "Hatchback":[9500,11500],"Sedan":[12000,15000],"SUV":[16500,21000],"Tempo Traveller":[22000,28000] }
};

let selectedVehicle = null;

function fmt(n) { return '₹' + n.toLocaleString('en-IN'); }

function selectVehicle(btn) {
    document.querySelectorAll('.vt-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedVehicle = btn.dataset.v;
    refreshPrice();
}

function refreshPrice() {
    const from    = (document.getElementById('qb-from').value || '').trim();
    const to      = document.getElementById('qb-to').value;
    const priceBox = document.getElementById('price-box');
    const noPriceBox = document.getElementById('no-price-box');
    const priceRange = document.getElementById('price-range');

    priceBox.classList.add('d-none');
    noPriceBox.classList.add('d-none');

    if (!to) return;

    const fromNorm = from.toLowerCase().replace(/\s/g,'');
    const isPatna  = fromNorm === 'patna';

    if (isPatna && selectedVehicle && PRICES[to] && PRICES[to][selectedVehicle]) {
        const [min, max] = PRICES[to][selectedVehicle];
        priceRange.textContent = fmt(min) + ' – ' + fmt(max);
        priceBox.classList.remove('d-none');
    } else if (to) {
        if (!isPatna || !selectedVehicle) {
            noPriceBox.classList.remove('d-none');
        }
    }
}

function bookNow() {
    const from = (document.getElementById('qb-from').value || 'Patna').trim();
    const to   = document.getElementById('qb-to').value;
    const dt   = document.getElementById('qb-datetime').value;

    if (!to) {
        document.getElementById('qb-to').classList.add('bw-error');
        document.getElementById('qb-to').focus();
        return;
    }
    document.getElementById('qb-to').classList.remove('bw-error');

    if (!selectedVehicle) {
        document.getElementById('vehicle-grid').classList.add('vt-error');
        return;
    }
    document.getElementById('vehicle-grid').classList.remove('vt-error');

    let amount = 0;
    const fromNorm = from.toLowerCase().replace(/\s/g,'');
    if (fromNorm === 'patna' && PRICES[to] && PRICES[to][selectedVehicle]) {
        amount = PRICES[to][selectedVehicle][0];
    }

    let url = '/Bookings/Create'
        + '?source='      + encodeURIComponent(from)
        + '&destination=' + encodeURIComponent(to)
        + '&vehicleType=' + encodeURIComponent(selectedVehicle);
    if (amount > 0) url += '&amount=' + amount;
    if (dt)        url += '&travelDateTime=' + encodeURIComponent(dt);

    window.location.href = url;
}

// default datetime = now + 1 hour
(function() {
    const d = new Date(Date.now() + 3600000);
    const pad = n => String(n).padStart(2,'0');
    document.getElementById('qb-datetime').value =
        d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate())
        + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
})();
</script>
}
