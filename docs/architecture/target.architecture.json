          "web",
          "rabbit"
        ],
        "note": "OtpRequested / BookingConfirmed is published to the ridefast.notifications exchange."
      },
      {
        "id": "deliver",
        "label": "Deliver notification",
        "focus": [
          "rabbit",
          "notif",
          "notiflog",
          "smtp",
          "sms"
        ],
        "note": "The worker consumes, dedupes by MessageId, sends email/SMS, then acks."
      },
      {
        "id": "failure",
        "label": "Failure path",
        "focus": [
          "rabbit",
          "dlq",
          "notif"
        ],
        "note": "Failed sends are retried via a TTL queue, then dead-lettered."
      }
    ]
